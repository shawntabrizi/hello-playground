{
  "name": "dotpages",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "preview": "vite preview",
    "deploy:dot": "npm run build && node scripts/deploy.mjs",
    "postinstall": "papi generate"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.2",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.0",
    "@ensdomains/content-hash": "^3.0.0",
    "@noble/hashes": "^1.4.0",
    "@parity/product-sdk-address": "^0.1.1",
    "@parity/product-sdk-chain-client": "^0.9.1",
    "@parity/product-sdk-cloud-storage": "^0.8.1",
    "@parity/product-sdk-contracts": "^0.9.2",
    "@parity/product-sdk-crypto": "^0.1.1",
    "@parity/product-sdk-descriptors": "^0.8.0",
    "@parity/product-sdk-host": "^0.14.1",
    "@parity/product-sdk-keys": "^0.3.16",
    "@parity/product-sdk-logger": "^0.1.1",
    "@parity/product-sdk-signer": "^0.11.1",
    "@parity/product-sdk-storage": "^0.1.5",
    "@parity/product-sdk-tx": "^0.3.2",
    "@parity/product-sdk-utils": "^0.1.1",
    "@polkadot-api/descriptors": "file:.papi/descriptors",
    "marked": "^18.0.4",
    "multiformats": "^13.3.1",
    "polkadot-api": "^2.1.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "viem": "^2.49.3"
  },
  "_comment_overrides": "@novasamatech/host-api floats to the ^0.8.7 that @parity/product-sdk-host needs (the old 0.7.9-4 pins are removed). @polkadot-api/json-rpc-provider is the standard upstream workaround.",
  "overrides": {
    "@polkadot-api/json-rpc-provider": "^0.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@polkadot-api/cli": "^0.21.2",
    "@polkadot-community-foundation/polkadot-app-deploy": "^0.13.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
